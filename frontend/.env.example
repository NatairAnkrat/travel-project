# Base URLs for the three publicly-routed backend services (see docs/openapi/README.md —
# there is no API gateway, so the frontend talks to all three directly).
# In OpenShift these are the Route hostnames. Locally, all three services
# default server.port=8080, so running them side by side means overriding
# SERVER_PORT per instance (e.g. 8081/8082/8083, matching below) — otherwise
# they'll collide trying to bind the same port.
VITE_AUTH_SERVICE_URL=http://localhost:8081
VITE_GROUP_SERVICE_URL=http://localhost:8082
VITE_TRAVEL_SERVICE_URL=http://localhost:8083
